# Local/WSL development only. The add-on itself reads options via run.sh -> env vars with the
# same BANK_SUMMARY_ prefix; this file is not used inside the add-on container.

BANK_SUMMARY_APPLICATION_ID=
BANK_SUMMARY_PRIVATE_KEY_PATH=secrets/enablebanking_private_key.pem
BANK_SUMMARY_REDIRECT_URL=http://localhost:8000/callback
BANK_SUMMARY_ASPSP_COUNTRY=DK
BANK_SUMMARY_DATA_DIR=data
